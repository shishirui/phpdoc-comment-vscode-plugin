{
  "name": "phpdoc-comment-vscode-plugin",
  "displayName": "PHPDoc Accrete Globus Technology",
  "description": "Add phpdoc @param and @return tag for selected function signatures.",
  "version": "1.3.0",
  "publisher": "hiteshgeek",
  "icon": "images/logo.png",
  "engines": {
    "vscode": "^1.24.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hiteshgeek/phpdoc-comment-accrete-globus-technology-vscode-plugin"
  },
  "activationEvents": [
    "onCommand:extension.addPHPComment"
  ],
  "main": "./extension",
  "contributes": {
    "commands": [
      {
        "command": "extension.addPHPComment",
        "title": "Generate PHP doc : Accrete Globus Solution"
      },
      {
        "command": "extension.addPHPDocForFile",
        "title": "Generate PHP doc for Entire File: Accrete Globus Solution"
      }
    ],
    "keybindings": [
      {
        "command": "extension.addPHPComment",
        "key": "ctrl+shift+0",
        "mac": "ctrl+shift+0",
        "when": "editorTextFocus"
      },
      {
        "command": "extension.addPHPDocForFile",
        "key": "ctrl+shift+1",
        "mac": "ctrl+shift+1",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.addPHPComment",
          "when": "resourceLangId == php"
        }
      ]
    }
  },
  "scripts": {
    "postinstall": "node ./node_modules/vscode/bin/install",
    "test": "node ./node_modules/vscode/bin/test"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/mocha": "^2.2.42",
    "@types/node": "^7.10.9",
    "eslint": "^4.11.0",
    "typescript": "^2.6.1",
    "vscode": "^1.1.36"
  }
}
