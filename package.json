{
    "name": "phpdoc-comment-vscode-plugin",
    "displayName": "PHPDoc Comment",
    "description": "Add phpdoc @param and @return tag for selected function signatures.",
    "version": "1.3.0",
    "publisher": "rexshi",
    "icon": "images/logo.png",
    "engines": {
        "vscode": "^1.24.0"
    },
    "categories": [
        "Other"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/shishirui/phpdoc-comment-vscode-plugin"
    },
    "activationEvents": [
        "onCommand:extension.addPHPComment"
    ],
    "main": "./extension",
    "contributes": {
        "commands": [
            {
                "command": "extension.addPHPComment",
                "title": "Add PHPDoc Comment"
            }
        ],
        "keybindings": [
            {
                "command": "extension.addPHPComment",
                "key": "ctrl+shift+i",
                "mac": "cmd+shift+i",
                "when": "editorTextFocus"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "extension.addPHPComment",
                    "when": "resourceLangId == php"
                }
            ]
        }
    },
    "scripts": {
        "lint": "eslint .",
        "test": "node ./test/runTest.js"
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "@types/vscode": "^1.24.0",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^8.57.1",
        "typescript": "^6.0.3"
    }
}
