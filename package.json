{
    "name": "phpdoc-comment-vscode-plugin",
    "displayName": "PHPDoc Comment",
    "description": "Generate PHPDoc blocks for modern PHP functions, properties, classes, interfaces, traits, and enums.",
    "version": "1.4.1",
    "publisher": "rexshi",
    "license": "MIT",
    "homepage": "https://github.com/shishirui/phpdoc-comment-vscode-plugin#readme",
    "bugs": {
        "url": "https://github.com/shishirui/phpdoc-comment-vscode-plugin/issues"
    },
    "keywords": [
        "php",
        "phpdoc",
        "docblock",
        "documentation",
        "annotations"
    ],
    "icon": "images/logo.png",
    "engines": {
        "vscode": "^1.24.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Other"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/shishirui/phpdoc-comment-vscode-plugin"
    },
    "activationEvents": [
        "onCommand:extension.addPHPComment"
    ],
    "main": "./extension",
    "contributes": {
        "commands": [
            {
                "command": "extension.addPHPComment",
                "title": "Add PHPDoc Comment",
                "enablement": "editorLangId == php"
            }
        ],
        "keybindings": [
            {
                "command": "extension.addPHPComment",
                "key": "ctrl+shift+i",
                "mac": "cmd+shift+i",
                "when": "editorTextFocus && editorLangId == php"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "extension.addPHPComment",
                    "when": "resourceLangId == php"
                }
            ]
        }
    },
    "scripts": {
        "check": "tsc -p jsconfig.json",
        "lint": "eslint .",
        "package": "npx --yes @vscode/vsce@3.9.2 package",
        "package:list": "npx --yes @vscode/vsce@3.9.2 ls",
        "test": "node --test ./test/unit/*.test.js",
        "test:integration": "node ./test/runTest.js",
        "vscode:prepublish": "npm run check && npm run lint && npm test"
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "@types/vscode": "^1.24.0",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^8.57.1",
        "typescript": "^6.0.3"
    }
}
