{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es6",
        "checkJs": true,  /* Typecheck .js files. */
        "maxNodeModuleJsDepth": 0,
        "noEmit": true,
        "types": [
            "node",
            "vscode"
        ],
        "lib": [
            "es6"
        ]
    },
    "include": [
        "extension.js",
        "src/**/*.js"
    ],
    "exclude": [
        "node_modules"
    ]
}
